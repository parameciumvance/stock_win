{
  "timeout_seconds": 3600,
  "max_rss_mb": 4096,
  "stages": [
    {
      "id": "quotes_2021_saved",
      "checkpoint": {
        "archive": "deliverables/tpex_2021/tpex_raw_type_2021_checkpoint.zip",
        "receipt": "deliverables/tpex_2021/pipeline_checkpoint_receipt.json"
      }
    },
    {
      "id": "bridge_2021",
      "command": [
        "{python}",
        "audit_tpex_event_coverage.py",
        "--year",
        "2021",
        "--output-dir",
        "deliverables/tpex_bridge_crossyear_2021"
      ],
      "inputs": [
        "audit_tpex_event_coverage.py",
        "deliverables/tpex_2021/quotes_with_type_2021.csv.gz",
        "deliverables/tpex_2021/annual_verification.json",
        "deliverables/tpex_2021/raw/excal_history.json",
        "deliverables/tpex_2021/raw/reduction_history.json",
        "deliverables/tpex_2021/raw/change_history.json",
        "configs/tpex_pool_policy.json",
        "deliverables/tpex_2021/raw/excal_history.json.meta.json",
        "deliverables/tpex_2021/raw/reduction_history.json.meta.json",
        "deliverables/tpex_2021/raw/change_history.json.meta.json"
      ],
      "outputs": [
        "deliverables/tpex_bridge_crossyear_2021/event_coverage.json",
        "deliverables/tpex_bridge_crossyear_2021/event_coverage_summary.json"
      ]
    },
    {
      "id": "bridge_2022",
      "command": [
        "{python}",
        "audit_tpex_event_coverage.py",
        "--year",
        "2022",
        "--output-dir",
        "deliverables/tpex_bridge_crossyear_2022",
        "--include-prior-year"
      ],
      "inputs": [
        "audit_tpex_event_coverage.py",
        "deliverables/tpex_2022/quotes_with_type_2022.csv.gz",
        "deliverables/tpex_2022/annual_verification.json",
        "deliverables/tpex_2021/quotes_with_type_2021.csv.gz",
        "deliverables/tpex_2021/annual_verification.json",
        "deliverables/tpex_2022/raw/excal_history.json",
        "deliverables/tpex_2022/raw/reduction_history.json",
        "deliverables/tpex_2022/raw/change_history.json",
        "configs/tpex_pool_policy.json",
        "deliverables/tpex_2022/raw/excal_history.json.meta.json",
        "deliverables/tpex_2022/raw/reduction_history.json.meta.json",
        "deliverables/tpex_2022/raw/change_history.json.meta.json"
      ],
      "outputs": [
        "deliverables/tpex_bridge_crossyear_2022/event_coverage.json",
        "deliverables/tpex_bridge_crossyear_2022/event_coverage_summary.json"
      ]
    },
    {
      "id": "bridge_2023",
      "command": [
        "{python}",
        "audit_tpex_event_coverage.py",
        "--year",
        "2023",
        "--output-dir",
        "deliverables/tpex_bridge_crossyear_2023",
        "--include-prior-year"
      ],
      "inputs": [
        "audit_tpex_event_coverage.py",
        "deliverables/tpex_2023/quotes_with_type_2023.csv.gz",
        "deliverables/tpex_2023/annual_verification.json",
        "deliverables/tpex_2022/quotes_with_type_2022.csv.gz",
        "deliverables/tpex_2022/annual_verification.json",
        "deliverables/tpex_pilot/history_probe.json",
        "deliverables/tpex_pilot/excal_history.json",
        "deliverables/tpex_pilot/reduction_history.json",
        "deliverables/tpex_pilot/change_history.json",
        "configs/tpex_pool_policy.json"
      ],
      "outputs": [
        "deliverables/tpex_bridge_crossyear_2023/event_coverage.json",
        "deliverables/tpex_bridge_crossyear_2023/event_coverage_summary.json"
      ]
    },
    {
      "id": "features_2021_2023",
      "command": [
        "{python}",
        "tpex_proxy_features.py",
        "--start-year",
        "2021",
        "--end-year",
        "2023",
        "--output",
        "deliverables/tpex_features_2022_crossyear",
        "--event-override",
        "2021=deliverables/tpex_bridge_crossyear_2021/event_coverage.json",
        "--event-override",
        "2022=deliverables/tpex_bridge_crossyear_2022/event_coverage.json",
        "--event-override",
        "2023=deliverables/tpex_bridge_crossyear_2023/event_coverage.json"
      ],
      "inputs": [
        "tpex_proxy_features.py",
        "configs/tpex_proxy_protocol.json",
        "deliverables/tpex_bridge_crossyear_2021/event_coverage.json",
        "deliverables/tpex_2021/quotes_with_type_2021.csv.gz",
        "deliverables/tpex_2021/annual_verification.json",
        "deliverables/tpex_2021/calendar_audit.json",
        "deliverables/tpex_bridge_crossyear_2022/event_coverage.json",
        "deliverables/tpex_2022/quotes_with_type_2022.csv.gz",
        "deliverables/tpex_2022/annual_verification.json",
        "deliverables/tpex_2022/calendar_audit.json",
        "deliverables/tpex_bridge_crossyear_2023/event_coverage.json",
        "deliverables/tpex_2023/quotes_with_type_2023.csv.gz",
        "deliverables/tpex_2023/annual_verification.json",
        "deliverables/tpex_2023/calendar_audit.json"
      ],
      "outputs": [
        "deliverables/tpex_features_2022_crossyear/features_and_gross_labels.csv.gz",
        "deliverables/tpex_features_2022_crossyear/summary.json",
        "deliverables/tpex_features_2022_crossyear/rule_daily_diagnostics.csv"
      ]
    },
    {
      "id": "rules_signal_2022",
      "command": [
        "{python}",
        "tpex_rule_comparison.py",
        "--root",
        "deliverables/tpex_features_2022_crossyear",
        "--benchmark",
        "deliverables/benchmark_2022_extended/prices_adjusted_2022_2026.csv.gz",
        "--benchmark-sha256",
        "fc66db9ea8a099abe7d4bb03e3c93cfddaa0a0fb9780bd899387fb3a41a3ac53",
        "--signal-year",
        "2022"
      ],
      "inputs": [
        "tpex_rule_comparison.py",
        "deliverables/benchmark_2022_extended/prices_adjusted_2022_2026.csv.gz",
        "deliverables/tpex_features_2022_crossyear/features_and_gross_labels.csv.gz",
        "deliverables/tpex_features_2022_crossyear/summary.json"
      ],
      "outputs": [
        "deliverables/tpex_features_2022_crossyear/rule_comparison.json",
        "deliverables/tpex_features_2022_crossyear/rule_comparison.md",
        "deliverables/tpex_features_2022_crossyear/rule_net_relative_daily.csv"
      ]
    },
    {
      "id": "uncertainty_signal_2022",
      "command": [
        "{python}",
        "audit_tpex_2022_rule_uncertainty.py",
        "--root",
        "deliverables/tpex_features_2022_crossyear"
      ],
      "inputs": [
        "audit_tpex_2022_rule_uncertainty.py",
        "tpex_ridge_baseline.py",
        "configs/tpex_ridge_protocol.json",
        "deliverables/tpex_2022/calendar_audit.json",
        "deliverables/tpex_features_2022_crossyear/rule_net_relative_daily.csv"
      ],
      "outputs": [
        "deliverables/tpex_features_2022_crossyear/uncertainty.json",
        "deliverables/tpex_features_2022_crossyear/review.md"
      ]
    },
    {
      "id": "audit_package_signal_2022",
      "command": [
        "{python}",
        "package_tpex_2022_proxy.py",
        "--root",
        "deliverables/tpex_features_2022_crossyear",
        "--benchmark-root",
        "deliverables/benchmark_2022_extended"
      ],
      "inputs": [
        "package_tpex_2022_proxy.py",
        "deliverables/tpex_features_2022_crossyear/summary.json",
        "deliverables/tpex_features_2022_crossyear/features_and_gross_labels.csv.gz",
        "deliverables/tpex_features_2022_crossyear/rule_comparison.json",
        "deliverables/tpex_features_2022_crossyear/uncertainty.json",
        "deliverables/benchmark_2022_extended/prices_adjusted_2022_2026.csv.gz",
        "deliverables/benchmark_2022_extended/summary.json",
        "deliverables/tpex_2021/saved_checkpoint.json",
        "deliverables/tpex_2022/saved_checkpoint.json",
        "deliverables/tpex_2023/saved_checkpoint.json",
        "deliverables/tpex_features_2022/research_saved_checkpoint.json"
      ],
      "outputs": [
        "deliverables/tpex_features_2022_crossyear/audit.json",
        "deliverables/tpex_features_2022_crossyear/research_checkpoint.json",
        "deliverables/tpex_features_2022_crossyear/tpex_rules_2022_research_checkpoint.zip"
      ]
    }
  ]
}
