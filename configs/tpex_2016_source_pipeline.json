{
  "timeout_seconds": 3600,
  "max_rss_mb": 4096,
  "stages": [
    {
      "id": "quotes_2016",
      "command": [
        "{python}",
        "acquire_tpex_year.py",
        "--year",
        "2016"
      ],
      "inputs": [
        "acquire_tpex_year.py",
        "acquire_tpex_month.py",
        "audit_tpex_calendar.py",
        "finalize_tpex_year.py",
        "tpex_source_pilot.py",
        "tpex_pool.py",
        "tpex_classification_pilot.py",
        "tpex_type_recovery.py",
        "configs/tpex_pool_policy.json",
        "deliverables/tpex_pilot/classification/isin.raw",
        "deliverables/tpex_pilot/classification/isin_listed.raw",
        "deliverables/tpex_pilot/classification/unknown_single_query.html",
        "tpex_history_scope.py",
        "configs/tpex_history_scope.json",
        "research_runtime.py"
      ],
      "outputs": [
        "deliverables/tpex_2016/quotes_with_type_2016.csv.gz",
        "deliverables/tpex_2016/calendar_audit.json",
        "deliverables/tpex_2016/annual_verification.json",
        "deliverables/tpex_2016/checkpoint.json",
        "deliverables/tpex_2016/tpex_raw_type_2016_checkpoint.zip"
      ]
    },
    {
      "id": "quotes_saved_2016",
      "checkpoint": {
        "archive": "deliverables/tpex_2016/tpex_raw_type_2016_checkpoint.zip",
        "receipt": "deliverables/tpex_2016/pipeline_checkpoint_receipt.json"
      }
    },
    {
      "id": "institutional_2016",
      "command": [
        "{python}",
        "acquire_tpex_flow_year.py",
        "--year",
        "2016"
      ],
      "inputs": [
        "acquire_tpex_flow_year.py",
        "tpex_flow_pilot.py",
        "research_runtime.py",
        "deliverables/tpex_2016/calendar_audit.json",
        "deliverables/tpex_2016/quotes_with_type_2016.csv.gz"
      ],
      "outputs": [
        "deliverables/tpex_flow_2016/institutional_tpex_2016.csv.gz",
        "deliverables/tpex_flow_2016/acquisition.json",
        "deliverables/tpex_flow_2016/coverage.csv",
        "deliverables/tpex_flow_2016/raw"
      ],
      "progress": "deliverables/tpex_flow_2016/download_progress.json"
    },
    {
      "id": "institutional_replay_package_2016",
      "command": [
        "{python}",
        "package_tpex_flow_source.py",
        "--year",
        "2016"
      ],
      "inputs": [
        "package_tpex_flow_source.py",
        "tpex_flow_pilot.py",
        "tpex_event_comparison.py",
        "deliverables/tpex_2016/calendar_audit.json",
        "deliverables/tpex_flow_2016/institutional_tpex_2016.csv.gz",
        "deliverables/tpex_flow_2016/acquisition.json",
        "deliverables/tpex_flow_2016/coverage.csv",
        "deliverables/tpex_flow_2016/raw"
      ],
      "outputs": [
        "deliverables/tpex_flow_2016/source_checkpoint.json",
        "deliverables/tpex_flow_2016/source_replay.json",
        "deliverables/tpex_flow_2016/tpex_institutional_source_2016_checkpoint.zip"
      ]
    },
    {
      "id": "institutional_saved_2016",
      "checkpoint": {
        "archive": "deliverables/tpex_flow_2016/tpex_institutional_source_2016_checkpoint.zip",
        "receipt": "deliverables/tpex_flow_2016/pipeline_checkpoint_receipt.json"
      }
    },
    {
      "id": "event_quote_bridge_2016",
      "command": [
        "{python}",
        "audit_tpex_event_coverage.py",
        "--year",
        "2016"
      ],
      "inputs": [
        "audit_tpex_event_coverage.py",
        "configs/tpex_pool_policy.json",
        "deliverables/tpex_2016/annual_verification.json",
        "deliverables/tpex_2016/quotes_with_type_2016.csv.gz",
        "deliverables/tpex_2016/raw/excal_history.json",
        "deliverables/tpex_2016/raw/reduction_history.json",
        "deliverables/tpex_2016/raw/change_history.json"
      ],
      "outputs": [
        "deliverables/tpex_2016/event_coverage.json",
        "deliverables/tpex_2016/event_coverage_summary.json"
      ]
    },
    {
      "id": "year_readiness_2016",
      "command": [
        "{python}",
        "audit_tpex_year_readiness.py",
        "--year",
        "2016"
      ],
      "inputs": [
        "audit_tpex_year_readiness.py",
        "research_runtime.py",
        "deliverables/tpex_2016/annual_verification.json",
        "deliverables/tpex_2016/calendar_audit.json",
        "deliverables/tpex_2016/quotes_with_type_2016.csv.gz",
        "deliverables/tpex_flow_2016/institutional_tpex_2016.csv.gz",
        "deliverables/tpex_flow_2016/acquisition.json",
        "deliverables/tpex_2016/event_coverage_summary.json"
      ],
      "outputs": [
        "deliverables/tpex_2016/readiness.json",
        "deliverables/tpex_2016/readiness.md",
        "deliverables/tpex_2016/unresolved_type_rows.csv",
        "deliverables/tpex_2016/candidate_type_rows.csv",
        "deliverables/tpex_2016/missing_institutional_primary_rows.csv"
      ]
    }
  ]
}
