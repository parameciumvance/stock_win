{
  "timeout_seconds": 3600,
  "max_rss_mb": 4096,
  "stages": [
    {
      "id": "quotes_saved_2019",
      "checkpoint": {
        "archive": "deliverables/tpex_2019/tpex_raw_type_2019_checkpoint.zip",
        "receipt": "deliverables/tpex_2019/pipeline_checkpoint_receipt.json"
      }
    },
    {
      "id": "institutional_2019",
      "command": [
        "{python}",
        "acquire_tpex_flow_year.py",
        "--year",
        "2019"
      ],
      "inputs": [
        "acquire_tpex_flow_year.py",
        "tpex_flow_pilot.py",
        "research_runtime.py",
        "deliverables/tpex_2019/calendar_audit.json",
        "deliverables/tpex_2019/quotes_with_type_2019.csv.gz"
      ],
      "outputs": [
        "deliverables/tpex_flow_2019/institutional_tpex_2019.csv.gz",
        "deliverables/tpex_flow_2019/acquisition.json",
        "deliverables/tpex_flow_2019/coverage.csv",
        "deliverables/tpex_flow_2019/raw"
      ],
      "progress": "deliverables/tpex_flow_2019/download_progress.json"
    },
    {
      "id": "institutional_replay_package_2019",
      "command": [
        "{python}",
        "package_tpex_flow_source.py",
        "--year",
        "2019"
      ],
      "inputs": [
        "package_tpex_flow_source.py",
        "tpex_flow_pilot.py",
        "tpex_event_comparison.py",
        "deliverables/tpex_2019/calendar_audit.json",
        "deliverables/tpex_flow_2019/institutional_tpex_2019.csv.gz",
        "deliverables/tpex_flow_2019/acquisition.json",
        "deliverables/tpex_flow_2019/coverage.csv",
        "deliverables/tpex_flow_2019/raw"
      ],
      "outputs": [
        "deliverables/tpex_flow_2019/source_checkpoint.json",
        "deliverables/tpex_flow_2019/source_replay.json",
        "deliverables/tpex_flow_2019/tpex_institutional_source_2019_checkpoint.zip"
      ]
    },
    {
      "id": "institutional_saved_2019",
      "checkpoint": {
        "archive": "deliverables/tpex_flow_2019/tpex_institutional_source_2019_checkpoint.zip",
        "receipt": "deliverables/tpex_flow_2019/pipeline_checkpoint_receipt.json"
      }
    },
    {
      "id": "event_quote_bridge_2019",
      "command": [
        "{python}",
        "audit_tpex_event_coverage.py",
        "--year",
        "2019"
      ],
      "inputs": [
        "audit_tpex_event_coverage.py",
        "configs/tpex_pool_policy.json",
        "deliverables/tpex_2019/annual_verification.json",
        "deliverables/tpex_2019/quotes_with_type_2019.csv.gz",
        "deliverables/tpex_2019/raw/excal_history.json",
        "deliverables/tpex_2019/raw/reduction_history.json",
        "deliverables/tpex_2019/raw/change_history.json"
      ],
      "outputs": [
        "deliverables/tpex_2019/event_coverage.json",
        "deliverables/tpex_2019/event_coverage_summary.json"
      ]
    },
    {
      "id": "year_readiness_2019",
      "command": [
        "{python}",
        "audit_tpex_year_readiness.py",
        "--year",
        "2019"
      ],
      "inputs": [
        "audit_tpex_year_readiness.py",
        "research_runtime.py",
        "deliverables/tpex_2019/annual_verification.json",
        "deliverables/tpex_2019/calendar_audit.json",
        "deliverables/tpex_2019/quotes_with_type_2019.csv.gz",
        "deliverables/tpex_flow_2019/institutional_tpex_2019.csv.gz",
        "deliverables/tpex_flow_2019/acquisition.json",
        "deliverables/tpex_2019/event_coverage_summary.json"
      ],
      "outputs": [
        "deliverables/tpex_2019/readiness.json",
        "deliverables/tpex_2019/readiness.md",
        "deliverables/tpex_2019/unresolved_type_rows.csv",
        "deliverables/tpex_2019/candidate_type_rows.csv",
        "deliverables/tpex_2019/missing_institutional_primary_rows.csv"
      ]
    }
  ]
}
