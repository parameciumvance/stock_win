{
  "timeout_seconds": 3600,
  "max_rss_mb": 4096,
  "stages": [
    {
      "id": "quotes_saved_2015",
      "checkpoint": {
        "archive": "deliverables/tpex_2015/tpex_raw_type_2015_checkpoint.zip",
        "receipt": "deliverables/tpex_2015/pipeline_checkpoint_receipt.json"
      }
    },
    {
      "id": "institutional_2015",
      "command": [
        "{python}",
        "acquire_tpex_flow_year.py",
        "--year",
        "2015"
      ],
      "inputs": [
        "acquire_tpex_flow_year.py",
        "tpex_flow_pilot.py",
        "research_runtime.py",
        "deliverables/tpex_2015/calendar_audit.json",
        "deliverables/tpex_2015/quotes_with_type_2015.csv.gz"
      ],
      "outputs": [
        "deliverables/tpex_flow_2015/institutional_tpex_2015.csv.gz",
        "deliverables/tpex_flow_2015/acquisition.json",
        "deliverables/tpex_flow_2015/coverage.csv",
        "deliverables/tpex_flow_2015/raw"
      ],
      "progress": "deliverables/tpex_flow_2015/download_progress.json"
    },
    {
      "id": "institutional_replay_package_2015",
      "command": [
        "{python}",
        "package_tpex_flow_source.py",
        "--year",
        "2015"
      ],
      "inputs": [
        "package_tpex_flow_source.py",
        "tpex_flow_pilot.py",
        "tpex_event_comparison.py",
        "deliverables/tpex_2015/calendar_audit.json",
        "deliverables/tpex_flow_2015/institutional_tpex_2015.csv.gz",
        "deliverables/tpex_flow_2015/acquisition.json",
        "deliverables/tpex_flow_2015/coverage.csv",
        "deliverables/tpex_flow_2015/raw"
      ],
      "outputs": [
        "deliverables/tpex_flow_2015/source_checkpoint.json",
        "deliverables/tpex_flow_2015/source_replay.json",
        "deliverables/tpex_flow_2015/tpex_institutional_source_2015_checkpoint.zip"
      ]
    },
    {
      "id": "institutional_saved_2015",
      "checkpoint": {
        "archive": "deliverables/tpex_flow_2015/tpex_institutional_source_2015_checkpoint.zip",
        "receipt": "deliverables/tpex_flow_2015/pipeline_checkpoint_receipt.json"
      }
    },
    {
      "id": "event_quote_bridge_2015",
      "command": [
        "{python}",
        "audit_tpex_event_coverage.py",
        "--year",
        "2015"
      ],
      "inputs": [
        "audit_tpex_event_coverage.py",
        "configs/tpex_pool_policy.json",
        "deliverables/tpex_2015/annual_verification.json",
        "deliverables/tpex_2015/quotes_with_type_2015.csv.gz",
        "deliverables/tpex_2015/raw/excal_history.json",
        "deliverables/tpex_2015/raw/reduction_history.json",
        "deliverables/tpex_2015/raw/change_history.json"
      ],
      "outputs": [
        "deliverables/tpex_2015/event_coverage.json",
        "deliverables/tpex_2015/event_coverage_summary.json"
      ]
    },
    {
      "id": "year_readiness_2015",
      "command": [
        "{python}",
        "audit_tpex_year_readiness.py",
        "--year",
        "2015"
      ],
      "inputs": [
        "audit_tpex_year_readiness.py",
        "research_runtime.py",
        "deliverables/tpex_2015/annual_verification.json",
        "deliverables/tpex_2015/calendar_audit.json",
        "deliverables/tpex_2015/quotes_with_type_2015.csv.gz",
        "deliverables/tpex_flow_2015/institutional_tpex_2015.csv.gz",
        "deliverables/tpex_flow_2015/acquisition.json",
        "deliverables/tpex_2015/event_coverage_summary.json"
      ],
      "outputs": [
        "deliverables/tpex_2015/readiness.json",
        "deliverables/tpex_2015/readiness.md",
        "deliverables/tpex_2015/unresolved_type_rows.csv",
        "deliverables/tpex_2015/candidate_type_rows.csv",
        "deliverables/tpex_2015/missing_institutional_primary_rows.csv"
      ]
    }
  ]
}
