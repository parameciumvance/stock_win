{
  "stages": [
    {
      "id": "acquire",
      "command": [
        "{python}",
        "bounded_public_sources.py",
        "configs/ipo_screen_years_sources.json"
      ],
      "inputs": [
        "ipo_screen.py",
        "tender_preflight.py",
        "bounded_public_sources.py",
        "source_checkpoint.py",
        "prospective_sources.py",
        "research_runtime.py",
        "configs/ipo_screen_protocol_20261019.json",
        "deliverables/ipo_screen_20261019/protocol_freeze.json",
        "configs/ipo_screen_years_sources.json"
      ],
      "outputs": [
        "inputs/ipo_screen_20261019/raw_years/results.json"
      ],
      "timeout_seconds": 80
    },
    {
      "id": "package",
      "command": [
        "{python}",
        "ipo_screen.py",
        "package",
        "--tag",
        "years"
      ],
      "inputs": [
        "ipo_screen.py",
        "tender_preflight.py",
        "bounded_public_sources.py",
        "source_checkpoint.py",
        "prospective_sources.py",
        "research_runtime.py",
        "configs/ipo_screen_protocol_20261019.json",
        "deliverables/ipo_screen_20261019/protocol_freeze.json",
        "configs/ipo_screen_years_sources.json",
        "inputs/ipo_screen_20261019/raw_years"
      ],
      "outputs": [
        "inputs/ipo_screen_20261019/years.zip",
        "deliverables/ipo_screen_20261019/years_package.json"
      ],
      "timeout_seconds": 30
    }
  ]
}
