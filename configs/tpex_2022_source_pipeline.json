{
  "timeout_seconds": 3600,
  "max_rss_mb": 4096,
  "stages": [
    {
      "id": "quotes_2022",
      "command": [
        "{python}",
        "acquire_tpex_year.py",
        "--year",
        "2022"
      ],
      "inputs": [
        "acquire_tpex_year.py",
        "acquire_tpex_month.py",
        "audit_tpex_calendar.py",
        "finalize_tpex_year.py",
        "tpex_source_pilot.py",
        "tpex_pool.py",
        "tpex_classification_pilot.py",
        "tpex_type_recovery.py",
        "configs/tpex_pool_policy.json",
        "deliverables/tpex_pilot/classification/isin.raw",
        "deliverables/tpex_pilot/classification/isin_listed.raw",
        "deliverables/tpex_pilot/classification/unknown_single_query.html"
      ],
      "outputs": [
        "deliverables/tpex_2022/quotes_with_type_2022.csv.gz",
        "deliverables/tpex_2022/calendar_audit.json",
        "deliverables/tpex_2022/annual_verification.json",
        "deliverables/tpex_2022/checkpoint.json",
        "deliverables/tpex_2022/tpex_raw_type_2022_checkpoint.zip"
      ]
    },
    {
      "id": "quotes_saved_2022",
      "checkpoint": {
        "archive": "deliverables/tpex_2022/tpex_raw_type_2022_checkpoint.zip",
        "receipt": "deliverables/tpex_2022/pipeline_checkpoint_receipt.json"
      }
    },
    {
      "id": "institutional_2022",
      "command": [
        "{python}",
        "acquire_tpex_flow_year.py",
        "--year",
        "2022"
      ],
      "inputs": [
        "acquire_tpex_flow_year.py",
        "tpex_flow_pilot.py",
        "research_runtime.py",
        "deliverables/tpex_2022/calendar_audit.json",
        "deliverables/tpex_2022/quotes_with_type_2022.csv.gz"
      ],
      "outputs": [
        "deliverables/tpex_flow_2022/institutional_tpex_2022.csv.gz",
        "deliverables/tpex_flow_2022/acquisition.json",
        "deliverables/tpex_flow_2022/coverage.csv",
        "deliverables/tpex_flow_2022/raw"
      ],
      "progress": "deliverables/tpex_flow_2022/download_progress.json"
    },
    {
      "id": "institutional_replay_package_2022",
      "command": [
        "{python}",
        "package_tpex_flow_source.py",
        "--year",
        "2022"
      ],
      "inputs": [
        "package_tpex_flow_source.py",
        "tpex_flow_pilot.py",
        "tpex_event_comparison.py",
        "deliverables/tpex_2022/calendar_audit.json",
        "deliverables/tpex_flow_2022/institutional_tpex_2022.csv.gz",
        "deliverables/tpex_flow_2022/acquisition.json",
        "deliverables/tpex_flow_2022/coverage.csv",
        "deliverables/tpex_flow_2022/raw"
      ],
      "outputs": [
        "deliverables/tpex_flow_2022/source_checkpoint.json",
        "deliverables/tpex_flow_2022/source_replay.json",
        "deliverables/tpex_flow_2022/tpex_institutional_source_2022_checkpoint.zip"
      ]
    },
    {
      "id": "institutional_saved_2022",
      "checkpoint": {
        "archive": "deliverables/tpex_flow_2022/tpex_institutional_source_2022_checkpoint.zip",
        "receipt": "deliverables/tpex_flow_2022/pipeline_checkpoint_receipt.json"
      }
    },
    {
      "id": "event_quote_bridge_2022",
      "command": [
        "{python}",
        "audit_tpex_event_coverage.py",
        "--year",
        "2022"
      ],
      "inputs": [
        "audit_tpex_event_coverage.py",
        "configs/tpex_pool_policy.json",
        "deliverables/tpex_2022/annual_verification.json",
        "deliverables/tpex_2022/quotes_with_type_2022.csv.gz",
        "deliverables/tpex_2022/raw/excal_history.json",
        "deliverables/tpex_2022/raw/reduction_history.json",
        "deliverables/tpex_2022/raw/change_history.json"
      ],
      "outputs": [
        "deliverables/tpex_2022/event_coverage.json",
        "deliverables/tpex_2022/event_coverage_summary.json"
      ]
    },
    {
      "id": "year_readiness_2022",
      "command": [
        "{python}",
        "audit_tpex_year_readiness.py",
        "--year",
        "2022"
      ],
      "inputs": [
        "audit_tpex_year_readiness.py",
        "research_runtime.py",
        "deliverables/tpex_2022/annual_verification.json",
        "deliverables/tpex_2022/calendar_audit.json",
        "deliverables/tpex_2022/quotes_with_type_2022.csv.gz",
        "deliverables/tpex_flow_2022/institutional_tpex_2022.csv.gz",
        "deliverables/tpex_flow_2022/acquisition.json",
        "deliverables/tpex_2022/event_coverage_summary.json"
      ],
      "outputs": [
        "deliverables/tpex_2022/readiness.json",
        "deliverables/tpex_2022/readiness.md",
        "deliverables/tpex_2022/unresolved_type_rows.csv",
        "deliverables/tpex_2022/candidate_type_rows.csv",
        "deliverables/tpex_2022/missing_institutional_primary_rows.csv"
      ]
    }
  ]
}
