        "inputs/prospective/20261016/matrix_60.csv",
        "inputs/prospective/20261016/benchmark.csv",
        "inputs/prospective/20261016/sources.retrieved.zip"
      ],
      "outputs": [
        "inputs/prospective/20261016/journal/signal/2026-10-16.json",
        "inputs/prospective/20261016/signal_checkpoint.json",
        "inputs/prospective/20261016/signal_bundle.zip"
